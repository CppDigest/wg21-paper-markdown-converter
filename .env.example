# Copy this file to .env for local development.
# In GitHub Actions, set these as repository secrets instead.

# Required for the OpenRouter PDF fallback (docling and pdfplumber do NOT need this).
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: override the default OpenRouter vision model.
OPENROUTER_MODEL=openai/gpt-4o
